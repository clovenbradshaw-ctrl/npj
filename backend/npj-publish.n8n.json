      "parameters": {
        "jsCode": "const FOUNDER = '@collective_boundary730383:hyphae.social';\nconst ARTICLE_RE = /^articles\\/[a-z0-9][a-z0-9-]*\\.jsonl$/;\n\nconst hook = $('Publish Webhook1').first().json;\nconst body = hook.body && typeof hook.body === 'object' ? hook.body : hook;\nconst filename = body && body.filename ? String(body.filename) : '';\nconst mode = body && body.mode ? String(body.mode) : 'overwrite';\n\nconst who = $('Whoami').first().json || {};\nconst userIdRaw = who.user_id || null;\nconst userId = userIdRaw ? String(userIdRaw).trim() : null;\n\nlet roles = {};\ntry {\n  const raw = $('Fetch Roles').first().json || {};\n  const text = typeof raw.data === 'string' ? raw.data : JSON.stringify(raw);\n  const parsed = JSON.parse(text);\n  const lay = parsed && (parsed.layout || parsed);\n  if (lay && lay.roles && typeof lay.roles === 'object') roles = lay.roles;\n} catch (e) {}\n\nconst isFounder = userId === FOUNDER;\nconst delegatedRole = userId ? (roles[userId] || null) : null;\nconst isAdmin = isFounder || delegatedRole === 'admin';\nconst role = isAdmin ? 'admin' : delegatedRole;\n\nconst isArticle = ARTICLE_RE.test(filename);\nconst modeOk = mode === 'append' || mode === 'overwrite';\nconst authorized = !!userId && !!filename && modeOk &&\n  (role === 'admin' || (role === 'editor' && isArticle));\n\nreturn [{ json: { authorized, user_id: userId, role, filename, mode, isArticle } }];"
      },
