      "parameters": {
        "jsCode": "// Surface the real archive.org result; build the public download URL on success.\nconst r = $input.first().json || {};\nconst built = $('Media Build').first().json || {};\nconst status = Number(r.statusCode || (r.error && (r.error.httpCode || r.error.status || r.error.statusCode)) || 0) || null;\nconst errored = !!r.error || (!built.hasBytes) || (status && status >= 400);\nconst ok = !errored && (!status || status < 400);\nconst url = ok ? ('https://archive.org/download/' + built.identifier + '/' + built.filename) : null;\nconst errMsg = !built.hasBytes ? 'no image bytes received'\n  : (errored ? ((typeof r.error === 'string' ? r.error : (r.error && r.error.message)) || ('archive.org upload failed (' + (status || '?') + ')')) : null);\nreturn [{ json: { ok, statusCode: ok ? 200 : (status || 502), url, error: errMsg, identifier: built.identifier, filename: built.filename } }];"
