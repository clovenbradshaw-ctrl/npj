      "id": "5a63460a-1be1-49f2-9585-c87e21117de4",
      "name": "GH Get File",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        336,
        128
      ],
      "webhookId": "1c9a6e7d-1c48-43e8-b978-a8385ddf439a",
      "credentials": {
        "githubOAuth2Api": {
          "id": "818QKPlLgc22aSHm",
          "name": "GitHub account"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Build Content — builds the file content + captures SHA, then routes to\n// GH Update/Create. ALSO the per-article permission gate for editors: the\n// existing file was just fetched, so this is the one place the log's genesis\n// assignees can be checked against the verified requester.\nconst hook = $('Publish Webhook').first().json;\nconst parsed = hook.body && typeof hook.body === 'object' ? hook.body : hook;\n\nconst filename   = parsed.filename;\nconst mode       = parsed.mode || 'overwrite';\nconst contentRaw = parsed.contentRaw != null ? String(parsed.contentRaw) : '';\nconst message    = parsed.message || `update ${filename}`;\nconst compress   = !!parsed.compress;\n\nif (!filename) {\n  throw new Error('Build Content: missing filename. Got keys: ' + Object.keys(parsed).join(','));\n}\n\n// GH Get File returns { content (base64), sha } on success, or an error\n// object on 404. continueOnFail is on, so we get both shapes here.\n// IMPORTANT: sha must be '' (not null) when absent — n8n's notEmpty check\n// coerces null to the string \"null\", which misroutes new files to Update\n// and GitHub 404s the edit.\nconst ghResp = $input.first().json || {};\nconst existingSha = ghResp.sha || '';\nconst existingB64 = ghResp.content || '';\n\nlet existingText = '';\nif (existingB64) {\n  try {\n    existingText = Buffer.from(existingB64, 'base64').toString('utf8');\n  } catch (e) {\n    existingText = '';\n  }\n}\n\n// ---- editor gate (admins skip this) ----------------------------------\n// Editors only reach this node for articles/<slug>.jsonl (see Authorize).\n// A NEW log (no existing file) is a fresh publish — allowed. Touching an\n// EXISTING log (append an edit, or re-publish over it) requires being in\n// the genesis line's assignees. The genesis is line 1 of the log.\nconst auth = $('Authorize').first().json || {};\nif (auth.role !== 'admin' && existingText) {\n  let assignees = [];\n  try {\n    const genesis = JSON.parse(existingText.split('\\n').find(l => l.trim()) || '{}');\n    const op = genesis.operand || {};\n    assignees = Array.isArray(op.assignees) ? op.assignees : [];\n  } catch (e) { /* unreadable genesis -> nobody but the admin */ }\n  if (!assignees.includes(auth.user_id)) {\n    return [{ json: { __forbidden: true, user_id: auth.user_id, filename,\n      error: 'not an assignee on this article' } }];\n  }\n}\n\n// Build final text\nlet finalText;\nif (mode === 'append') {\n  const prev = existingText ? (existingText.endsWith('\\n') ? existingText : existingText + '\\n') : '';\n  const next = contentRaw.endsWith('\\n') ? contentRaw : contentRaw + '\\n';\n  finalText = prev + next;\n} else {\n  finalText = contentRaw;\n}\n\n// Optional gzip\nlet b64;\nif (compress) {\n  const zlib = require('zlib');\n  b64 = zlib.gzipSync(Buffer.from(finalText, 'utf8')).toString('base64');\n} else {\n  b64 = Buffer.from(finalText, 'utf8').toString('base64');\n}\n\nreturn [{ json: {\n  __forbidden: false,\n  filename,\n  message,\n  contentBase64: b64,\n  sha: existingSha,\n  bytes: finalText.length,\n}}];"
      },
