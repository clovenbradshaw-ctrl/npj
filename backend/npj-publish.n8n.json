    {
      "parameters": {
        "jsCode": "// Media auth: a valid Matrix token whose account is admin/editor may upload.\nconst who = $('Media Whoami').first().json || {};\nconst userId = who.user_id ? String(who.user_id).trim() : null;\nconst FOUNDER = '@collective_boundary730383:hyphae.social';\nlet roles = {};\ntry {\n  const raw = $('Media Fetch Roles').first().json || {};\n  const text = typeof raw.data === 'string' ? raw.data : JSON.stringify(raw);\n  const parsed = JSON.parse(text);\n  const lay = (parsed && parsed.layout) || parsed;\n  if (lay && lay.roles && typeof lay.roles === 'object') roles = lay.roles;\n} catch (e) {}\nconst role = userId === FOUNDER ? 'admin' : (userId ? (roles[userId] || null) : null);\nconst authorized = !!userId && (role === 'admin' || role === 'editor');\nreturn [{ json: { authorized, user_id: userId, role } }];"
