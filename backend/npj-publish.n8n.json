    {
      "parameters": {
        "jsCode": "const hook = $('Publish Webhook1').first().json;\nconst parsed = hook.body && typeof hook.body === 'object' ? hook.body : hook;\n\nconst filename   = parsed.filename;\nconst mode       = parsed.mode || 'overwrite';\nconst contentRaw = parsed.contentRaw != null ? String(parsed.contentRaw) : '';\nconst message    = parsed.message || `update ${filename}`;\nconst compress   = !!parsed.compress;\n\nif (!filename) {\n  throw new Error('Build Content: missing filename. Got keys: ' + Object.keys(parsed).join(','));\n}\n\nconst ghResp = $input.first().json || {};\nconst existingSha = ghResp.sha || '';\nconst existingB64 = ghResp.content || '';\n\nlet existingText = '';\nif (existingB64) {\n  try {\n    existingText = Buffer.from(existingB64, 'base64').toString('utf8');\n  } catch (e) {\n    existingText = '';\n  }\n}\n\nconst auth = $('Authorize').first().json || {};\nconst isAdmin = auth.role === 'admin';\nif (!isAdmin && existingText) {\n  let assignees = [];\n  try {\n    const genesis = JSON.parse(existingText.split('\\n').find(l => l.trim()) || '{}');\n    const op = genesis.operand || {};\n    assignees = Array.isArray(op.assignees) ? op.assignees : [];\n  } catch (e) {}\n  if (!assignees.includes(auth.user_id)) {\n    return [{ json: { __forbidden: true, user_id: auth.user_id, role: auth.role, filename,\n      error: 'not an assignee on this article' } }];\n  }\n}\n\nlet finalText;\nif (mode === 'append') {\n  const prev = existingText ? (existingText.endsWith('\\n') ? existingText : existingText + '\\n') : '';\n  const next = contentRaw.endsWith('\\n') ? contentRaw : contentRaw + '\\n';\n  finalText = prev + next;\n} else {\n  finalText = contentRaw;\n}\n\nlet b64;\nif (compress) {\n  const zlib = require('zlib');\n  b64 = zlib.gzipSync(Buffer.from(finalText, 'utf8')).toString('base64');\n} else {\n  b64 = Buffer.from(finalText, 'utf8').toString('base64');\n}\n\nreturn [{ json: {\n  __forbidden: false,\n  filename,\n  message,\n  contentBase64: b64,\n  sha: existingSha,\n  bytes: finalText.length,\n  user_id: auth.user_id,\n  role: auth.role,\n}}];"
      },
