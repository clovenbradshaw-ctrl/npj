    {
      "parameters": {
        "jsCode": "// Decode the posted image into n8n binary data + a safe archive.org identifier.\nconst hook = $('Media Webhook').first().json;\nconst body = hook.body && typeof hook.body === 'object' ? hook.body : hook;\nconst identifier = (String(body.identifier || 'npj-media').replace(/[^A-Za-z0-9._-]/g,'-').replace(/^-+|-+$/g,'').slice(0,90)) || 'npj-media';\nconst filename = (String(body.filename || ('img-'+Date.now()+'.webp')).replace(/[^A-Za-z0-9._-]/g,'')) || ('img-'+Date.now()+'.webp');\nconst b64 = String(body.contentBase64 || '');\nconst mime = String(body.mimetype || 'image/webp');\nconst title = String(body.title || '').replace(/[^\\x20-\\x7E]/g,'').slice(0,180);\nreturn [{ json: { identifier, filename, title, mime, hasBytes: !!b64 }, binary: { data: { data: b64, mimeType: mime, fileName: filename } } }];"
