      "webhookId": "npj-api",
      "notes": "POST /webhook/npj-api\nHeaders: Authorization: Bearer <matrix_access_token>   (browser users)\nBody (service callers): { token: <NPJ_INGEST_TOKEN>, op, ... }\nBody (all): { op: read|propose|resolve|delete, ... }\nSet allowedOrigins to the Pages site origin for CORS."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c-svc",
              "leftValue": "={{ $json.body.token }}",
              "rightValue": "={{ $env.NPJ_INGEST_TOKEN }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
